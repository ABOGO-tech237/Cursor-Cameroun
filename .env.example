# Copier vers .env. Ne jamais commiter de vraies valeurs.
# La simulation d'e-mail (sans RESEND_API_KEY) ne fonctionne qu'avec `npm run dev`.
# En production, une clé absente fait répondre 503 sur /api/send.

# Clé API Resend. Laisser vide en développement local pour simuler l'envoi.
RESEND_API_KEY=

# Expéditeur vérifié chez Resend. Exemple de format, sans domaine réel :
# Cursor Cameroun <contact@example.com>
RESEND_FROM=

# Destinataire des messages du formulaire de contact.
CONTACT_EMAIL=

# URL publique du site (sitemap, robots). Exemple : https://example.com
NEXT_PUBLIC_SITE_URL=

# Secret de signature des sessions admin (src/lib/auth.ts).
# Chaîne longue et aléatoire. Ne pas réutiliser un mot de passe.
AUTH_SECRET=

# Mot de passe du tableau de bord admin. Repli de AUTH_SECRET s'il est vide.
ADMIN_PASSWORD=

# Cloudflare Turnstile, widget en mode Invisible.
# Les deux clés doivent être définies ensemble pour activer la vérification.
# Laisser les deux vides pour la désactiver (développement).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Base Postgres (événements). Non utilisée par le limiteur de débit, qui est en mémoire.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
